{
  "buildCommand": "npm run build:chimera",
  "outputDirectory": "apps/chimera/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/chimera-phase1-security-preservation": false,
      "codex/chimera-phases1-6-release": false
    }
  }
}
