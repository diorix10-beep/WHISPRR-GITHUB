{
  "name": "whisprr-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "build:chimera": "npm run build --workspace=chimera",
    "typecheck:chimera": "npm run typecheck --workspace=chimera",
    "dev:whisprr:local": "npm run dev --workspace=whisprr",
    "dev:chimera:local": "npm run dev --workspace=chimera -- --host 127.0.0.1 --port 5174",
    "supabase:local:start": "./scripts/supabase-local.sh start",
    "supabase:local:stop": "./scripts/supabase-local.sh stop",
    "supabase:local:status": "./scripts/supabase-local.sh status",
    "supabase:local:reset": "./scripts/supabase-local.sh reset",
    "supabase:local:restore": "./scripts/supabase-local.sh restore-backup",
    "supabase:local:test": "./scripts/supabase-local.sh test",
    "supabase:local:test:chimera": "./scripts/supabase-local.sh test-chimera",
    "supabase:local:functions": "./scripts/supabase-local.sh functions"
  },
  "dependencies": {
    "stripe": "^18.5.0"
  }
}
