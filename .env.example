# Public Supabase config used by Vite clients.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase key for API routes.
# Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only model provider keys for CHIMERA API routes.
GEMINI_API_KEY_SERVER=
OPENROUTER_API_KEY=

# Public app URL used by server-side callbacks and checkout redirects.
CHIMERA_APP_URL=https://chimera.it.com
