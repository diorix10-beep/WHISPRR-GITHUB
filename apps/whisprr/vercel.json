{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/pr9-review-fixes": false,
      "codex/roleplay-revocation-retry-fixes": false
    }
  }
}
